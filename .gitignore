# Build output
/target/

# Python bytecode caches (from CI helper scripts under ci/jenkins/)
__pycache__/
*.py[cod]

# Uncompressed vendor sources — always extract from the vendor.tar.gz.* parts; never commit the directory
/vendor/
# CI marker recording which vendor set the extracted vendor/ came from (ci/jenkins/setup-vendor.sh)
/.vendor-stamp

# .cargo/config.toml is written by CI (Jenkinsfile) and local airgap scripts; not committed
# so that online dev builds continue to use crates.io by default.
/.cargo/config.toml

# CI/local air-gap replay homes: CARGO_HOME=${CI_PROJECT_DIR}/.cargo and
# RUSTUP_HOME=${CI_PROJECT_DIR}/.rustup, where the committed toolchain bundle is
# extracted (~1 GB). Never commit — the bundle lives under toolchain/.
/.cargo/
/.rustup/

# Logs and temp files
*.log
*.tmp
*.bak
/logs/

# OS artefacts
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/

# Secrets / local env
.env
ci/jenkins/.env

# Local setup notes — not for publication
sonarqube-manual-setup.md

# Signing cert generation output — private keys and PFX bundles, never committed
/_signing/

# Private-key / cert-bundle material anywhere in the tree (defence-in-depth; the
# pre-commit hook also hard-blocks these). Test fixtures under vendor/ are exempt
# because they are crate sources, not real keys.
*.key
*.pfx
*.p12
*.jks
*.keystore
id_rsa
id_ed25519
!vendor/**/*.pem
!vendor/**/*.key

# Local test output (not for commit)
out/
out.7z
tmp-sloc/

# Loose report artefacts from local runs
result.json
result.html
result.pdf

# Clippy machine-readable output (generated by CI/SonarQube scripts)
clippy.json
clippy-sonar.json
clippy.stderr

# Coverage / profiling (cargo-llvm-cov, grcov, cargo-flamegraph)
*.profraw
*.profdata
lcov*.info
flamegraph.svg
perf.data
perf.data.old

# Compiled binaries — never committed; users build from toolchain/ + vendor sources
*.exe
*.dll
/oxide-sloc

# dist/ — ignored for local builds to prevent accidental commits.
# update-dist.yml uses `git add -f` to intentionally commit the signed
# Windows zip (oxide-sloc-windows-x64.zip) after each release.
/dist/

# toolchain/ — bundled Rust toolchain archives (7-zip level 9, split into ≤45 MB parts)
# committed by maintainers via bundle-rust-toolchain.sh. Only ignore temp extraction dirs.
/toolchain/tmp/
/.tools/

# Generated report artefacts under testing/fixtures/
testing/fixtures/**/sloc/

# JUnit test report written to the repo root by the CI test job
junit.xml

# Concrete Rust toolchain name recorded by ci/jenkins/setup-toolchain.sh so the
# pipeline can pin RUSTUP_TOOLCHAIN across stages (air-gap channel-sync fix)
.rust-toolchain-name

# Transferable bundle archives created by `make bundle`
/oxide-sloc-bundle*.7z
/oxide-sloc-bundle*.tar.gz

# Claude Code (project-local AI context — not for commit)
CLAUDE.md
.claude

# Corporate secure profile — the filled-in env holds secrets; keep only the .example
deploy/corp.env

# Editor / build integration output - regeneratable, never committed
editors/vscode/node_modules/
editors/vscode/out/
editors/vscode/*.vsix
examples/cmake/build/
