# Set to your Jenkins host. LAN/remote URLs are fine. Strip any trailing slash.
# 'export' prefixes let bash scripts (child processes) inherit these.
export JENKINS_URL=http://localhost:8080
export JENKINS_USER=admin
export JENKINS_TOKEN=
# JOB_NAME — keep as "oxide-sloc" for the documented setup.
# Use a different name (e.g. "oxide-sloc-manual") only if you are
# maintaining a SECOND, hand-edited copy of the pipeline alongside
# the SCM-driven one. The default works for 99% of users.
export JOB_NAME=oxide-sloc

# The git repo Jenkins fetches the Jenkinsfile from (the "tooling" repo the scanner
# is built from) — NOT the project you scan (that's the SCAN_REPO_URL build param).
# REQUIRED: there is no hardcoded internet default anywhere in the pipeline, so this
# is the single place you point at your own instance. On an air-gapped controller use
# a local mirror, e.g.:
#   export REPO_URL=file:///srv/git/oxide-sloc.git
#   export REPO_URL=https://git.internal.example/oxide-sloc/oxide-sloc.git
#   export REPO_URL=ssh://git@bitbucket.internal.example/oxide/oxide-sloc.git
export REPO_URL=https://git.example.com/oxide-sloc/oxide-sloc.git

# Branch/ref the pipeline SCM checks out. Defaults to the concrete ref `main` when
# unset. Use a concrete ref, NOT the wildcard */main: lightweight (jgit) checkout NPEs
# on a wildcard at Jenkinsfile load.
export REPO_BRANCH=main

# Bitbucket integration (optional — only needed if using Bitbucket as SCM)
export BITBUCKET_URL=https://bitbucket.example.com
export BITBUCKET_PROJECT=OXIDE
export BITBUCKET_REPO=oxide-sloc

# ── Release/tag webhook trigger (optional) ────────────────────────────────────
# When enabled, render-job-config.sh adds a Generic Webhook Trigger so a GitHub or
# Bitbucket "release" / tag-push webhook starts the scan and maps the pushed tag
# into SCAN_REF. Requires the generic-webhook-trigger plugin. The scanned repo posts
# to: <JENKINS_URL>/generic-webhook-trigger/invoke?token=<SLOC_WEBHOOK_TRIGGER_TOKEN>
# See docs/ci-integrations.md for the GitHub/Bitbucket webhook setup and per-provider
# JSONPath overrides.
# export SLOC_ENABLE_WEBHOOK_TRIGGER=1
# export SLOC_WEBHOOK_TRIGGER_TOKEN=change-me-please
# export SLOC_WEBHOOK_TAG_JSONPATH='$.release.tag_name'   # GitHub release (default)
# export SLOC_WEBHOOK_URL_JSONPATH='$.repository.clone_url'
# export SLOC_SCM_POLL_SPEC=                              # blank = webhook/push only
