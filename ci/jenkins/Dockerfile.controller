# Jenkins controller image for oxide-sloc — fully air-gapped.
#
# All required plugins are installed from jenkins-plugins.tar.xz, which is
# committed to the repository alongside the vendor.tar.gz.* parts and (optionally)
# rust-toolchain-bundle.tar.xz.  No internet access is needed after
# `git clone` + `docker build`.
#
# ── Prerequisites ──────────────────────────────────────────────────────────────
# Generate the plugin bundle once on a networked machine, then commit:
#
#   bash ci/jenkins/bundle-jenkins-plugins.sh
#   git add jenkins-plugins.tar.xz jenkins-plugins.tar.xz.sha256
#   git commit -m "ci: bundle Jenkins plugins for air-gapped install"
#
# ── Build ──────────────────────────────────────────────────────────────────────
# Always build from the repository root so that COPY paths resolve correctly:
#
#   docker build \
#       -t jenkins-oxide-sloc-controller:latest \
#       -f ci/jenkins/Dockerfile.controller \
#       .
#
# ── Run (standalone) ───────────────────────────────────────────────────────────
#   docker run -d \
#       --name jenkins-controller \
#       -p 8080:8080 \
#       -v jenkins_home:/var/jenkins_home \
#       jenkins-oxide-sloc-controller:latest
#
# ── Run with docker-compose ───────────────────────────────────────────────────
# In your docker-compose.yml, replace:
#   image: jenkins/jenkins:lts
# with:
#   build:
#     context: .
#     dockerfile: ci/jenkins/Dockerfile.controller
#   image: jenkins-oxide-sloc-controller:latest
#
# ── Updating plugins ───────────────────────────────────────────────────────────
# Whenever ci/jenkins/plugins.txt changes (a plugin is added or removed):
#   1.  bash ci/jenkins/bundle-jenkins-plugins.sh
#   2.  git add jenkins-plugins.tar.xz jenkins-plugins.tar.xz.sha256
#   3.  git commit -m "ci: update Jenkins plugin bundle"
#   4.  docker build ... (rebuild the image)
#   5.  docker compose up -d  (or equivalent restart)

# Digest pinned (tag lts-jdk21) to prevent silent base-image substitution.
# To update: docker pull jenkins/jenkins:lts-jdk21 && docker inspect --format '{{index .RepoDigests 0}}' jenkins/jenkins:lts-jdk21
FROM jenkins/jenkins@sha256:f4f65e6cd1405cd889b7f5ac33f9d5cdc2a099de6b87fe8a3933b9c5d53d1d02

USER root

# xz-utils — required to decompress jenkins-plugins.tar.xz during image build.
# Versions left unpinned so the patch level tracks upstream.
# hadolint ignore=DL3005,DL3008
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends xz-utils \
    && rm -rf /var/lib/apt/lists/*

# ── Copy and verify the plugin bundle ─────────────────────────────────────────
# The build context is the repository root (see Build section above).
# Both files are committed to the repo by bundle-jenkins-plugins.sh.
COPY jenkins-plugins.tar.xz        /tmp/jenkins-plugins.tar.xz
COPY jenkins-plugins.tar.xz.sha256 /tmp/jenkins-plugins.tar.xz.sha256

# Verify the archive, then extract all .hpi/.jpi files into the Jenkins
# reference directory.  Files in /usr/share/jenkins/ref/plugins/ are copied
# to $JENKINS_HOME/plugins/ on first container start by the copy_reference_file
# mechanism built into the base jenkins/jenkins:lts image.
#
# Pin all plugins after extraction:  .hpi.pinned marker files tell Jenkins
# not to replace these versions from the update center — appropriate for an
# air-gapped environment where update-center access is either unavailable or
# intentionally blocked.
RUN set -eux; \
    cd /tmp; \
    echo "==> Verifying jenkins-plugins.tar.xz..."; \
    sha256sum -c jenkins-plugins.tar.xz.sha256; \
    echo "==> Extracting plugins to /usr/share/jenkins/ref/plugins/..."; \
    mkdir -p /usr/share/jenkins/ref/plugins; \
    tar -xJf jenkins-plugins.tar.xz -C /usr/share/jenkins/ref/plugins; \
    echo "==> Pinning plugins..."; \
    for f in /usr/share/jenkins/ref/plugins/*.hpi \
              /usr/share/jenkins/ref/plugins/*.jpi; do \
        [ -f "$f" ] && touch "${f%.hpi}.hpi.pinned" "${f%.jpi}.hpi.pinned" 2>/dev/null || true; \
    done; \
    PLUGIN_COUNT=$(ls /usr/share/jenkins/ref/plugins/*.hpi \
                      /usr/share/jenkins/ref/plugins/*.jpi 2>/dev/null | wc -l); \
    echo "==> Installed and pinned ${PLUGIN_COUNT} plugins."; \
    rm /tmp/jenkins-plugins.tar.xz /tmp/jenkins-plugins.tar.xz.sha256

# ── CSP init script ────────────────────────────────────────────────────────────
# Relaxes the Content-Security-Policy so the SLOC HTML report and Coverage
# Source HTML report render correctly in the Jenkins artifact viewer.
# Equivalent to dropping the script into $JENKINS_HOME/init.groovy.d/ at runtime.
COPY ci/jenkins/init.groovy.d/ /usr/share/jenkins/ref/init.groovy.d/

# ── Disable the first-run setup wizard ────────────────────────────────────────
# The wizard prompts for plugin selection and an admin user — both are handled
# by this Dockerfile and the initial credentials configuration in Jenkins.
ENV JAVA_OPTS="-Djenkins.install.runSetupWizard=false"

# ── Bootstrap admin credentials ────────────────────────────────────────────────
# Provided as build args so an operator bakes their own credentials at build time,
# fully offline for air-gapped installs — no value is fixed in the committed source:
#   docker build \
#     --build-arg JENKINS_ADMIN_USER=<user> \
#     --build-arg JENKINS_ADMIN_PASSWORD='<strong-password>' \
#     -f ci/jenkins/Dockerfile.controller -t jenkins-oxide-sloc-controller .
# For CI, pass the password from a secret store (e.g. --build-arg
# JENKINS_ADMIN_PASSWORD="$(cat /run/secrets/jenkins_admin_password)").
# The admin username defaults to "admin"; the password has NO default and MUST be
# supplied at build time — the build fails below if it is empty, so no shared
# credential is ever baked into the committed source or a published image.
ARG JENKINS_ADMIN_USER=admin
ARG JENKINS_ADMIN_PASSWORD
RUN test -n "${JENKINS_ADMIN_PASSWORD}" || { \
      echo "ERROR: build-arg JENKINS_ADMIN_PASSWORD is required and has no default." >&2; \
      echo "  docker build --build-arg JENKINS_ADMIN_PASSWORD='<strong-password>' \\" >&2; \
      echo "    -f ci/jenkins/Dockerfile.controller -t jenkins-oxide-sloc-controller ." >&2; \
      exit 1; \
    }
ENV JENKINS_OPTS="--argumentsRealm.roles.user=${JENKINS_ADMIN_USER} --argumentsRealm.passwd.${JENKINS_ADMIN_USER}=${JENKINS_ADMIN_PASSWORD}"

# Liveness probe: confirm the Jenkins HTTP port is accepting connections.
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
    CMD bash -c 'exec 3<>/dev/tcp/localhost/8080' || exit 1

USER jenkins
