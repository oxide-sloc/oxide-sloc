# Dockerfile.rhel-build — produce a RHEL 8/9-compatible oxide-sloc Linux binary.
#
# WHY UBI 8: the binary is compiled against the glibc that ships in the builder
# image. UBI 8 carries glibc 2.28, so the resulting binary is forward-compatible
# with RHEL 8 (glibc 2.28), RHEL 9 (glibc 2.34) and RHEL 10 — the classic
# "build on the OLDEST glibc you must support" rule. Building on Debian
# bookworm (glibc 2.36, the runtime Dockerfile's base) would emit a binary that
# fails on RHEL 8/9 with "GLIBC_2.3x not found", which is exactly what this file
# exists to avoid.
#
# This is a BUILD-ONLY image: its sole output is the bare binary, exported via
# BuildKit to the host with no runtime layers. Extract it with:
#
#   DOCKER_BUILDKIT=1 docker build -f Dockerfile.rhel-build \
#     --output type=local,dest=./out .
#   # -> ./out/oxide-sloc  (RHEL 8/9/10-compatible)
#
# The crate build is fully offline: it consumes the committed split vendor
# parts (vendor.tar.gz.aa/.ab/.ac, verified by sha256) via
# ci/docker-cargo-config.toml, so no crates.io access is required. Only the
# one-time rustup bootstrap needs the network.
#
# Hardened builds may substitute an approved UBI mirror WITHOUT editing
# this file, e.g.:
#   docker build -f Dockerfile.rhel-build \
#     --build-arg BUILDER_IMAGE=registry.example.com/ubi/ubi8:8.10 .
# NOTE: an ARG used in FROM must be declared before the first FROM (global scope).
# Digest pinned to prevent silent base-image substitution (Scorecard Pinned-Dependencies).
# To update: docker buildx imagetools inspect registry.access.redhat.com/ubi8/ubi:8.10
#            (copy the top-level "Digest:" manifest-list sha256).
ARG BUILDER_IMAGE=registry.access.redhat.com/ubi8/ubi:8.10@sha256:efe7eaa64e1efb79c34d0e9ec4ac6d0a95f512dfa8673c2d0d7dfa78a6787efe
FROM ${BUILDER_IMAGE} AS builder

# Fail a piped RUN if any stage in the pipe fails (e.g. `echo ... | sha256sum -c`
# and `cat vendor.tar.gz.* | tar`), not just the last. UBI 8 ships bash.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# This builder stage runs as root only while compiling and is then discarded; the
# `export` stage below (FROM scratch) ships just the binary, so no root-owned
# runtime layer is ever produced.

# Rust toolchain version — keep in lockstep with rust-toolchain.toml (channel).
# Passing the minor series ("1.96") lets rustup select the latest matching patch,
# which is what the workspace's rust-toolchain.toml also resolves to.
ARG RUST_VERSION=1.97

# gcc (+ its binutils dependency) is the linker; tar/gzip unpack the split
# vendor parts; findutils/coreutils provide sha256sum. UBI repos serve all of
# these without a subscription.
RUN dnf -y --setopt=install_weak_deps=false install \
        gcc \
        binutils \
        tar \
        gzip \
        findutils \
        ca-certificates \
    && dnf clean all

# Install the pinned Rust toolchain via rustup (network is required here, and
# only here). Components mirror rust-toolchain.toml so that cargo — which honours
# the workspace override file — never tries to fetch a missing component mid-build.
#
# The rustup bootstrap script is downloaded to a file and verified against a
# pinned SHA-256 before execution rather than piped straight into a shell
# (Scorecard Pinned-Dependencies). To update after a rustup.rs change:
#   curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o rustup-init.sh
#   sha256sum rustup-init.sh
ARG RUSTUP_INIT_SHA256=6c30b75a75b28a96fd913a037c8581b580080b6ee9b8169a3c0feb1af7fe8caf
ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o rustup-init.sh \
    && echo "${RUSTUP_INIT_SHA256}  rustup-init.sh" | sha256sum -c - \
    && sh rustup-init.sh -y --profile minimal --default-toolchain "${RUST_VERSION}" \
    && rm rustup-init.sh \
    && rustup component add rustfmt clippy llvm-tools \
    && rustc --version

WORKDIR /app

# Manifests + toolchain pin first so this layer caches across source-only edits.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
RUN mkdir -p .cargo
COPY ci/docker-cargo-config.toml .cargo/config.toml
COPY crates/ crates/
COPY docs/ docs/
COPY vendor.tar.gz.aa vendor.tar.gz.ab vendor.tar.gz.ac vendor.checksums.sha256 ./

# Verify the split vendor parts against their committed checksums, then
# reassemble and extract. This must precede `cargo build` because
# .cargo/config.toml points cargo at the vendor/ directory as the sole (offline)
# crate source. gzip is used (not xz) because it is universally available.
RUN sha256sum -c vendor.checksums.sha256 \
    && cat vendor.tar.gz.* | tar -xzf - \
    && rm -f vendor.tar.gz.*

# Pre-flight: fail loudly if crates/ was accidentally excluded from the context
# (e.g. re-added to .dockerignore) rather than emitting a cryptic manifest error.
RUN test -d crates/sloc-config \
    || { \
         echo "ERROR: crates/sloc-config is missing from the Docker build context." >&2; \
         echo "Check .dockerignore — crates/ must not be excluded." >&2; \
         exit 1; \
       }

# --no-default-features drops the rfd/GTK desktop file-picker, which is neither
# available nor wanted in a headless RHEL deployment (matches ci/release.sh).
# --offline guarantees the build never reaches for the network.
# strip shrinks the binary; RPM/tar consumers expect an already-stripped artifact.
RUN cargo build --release -p oxide-sloc --no-default-features --offline \
    && strip target/release/oxide-sloc \
    && ./target/release/oxide-sloc --version

# Export stage: an empty base holding only the bare binary, so
# `docker build --output type=local` emits just the file (no image layers).
FROM scratch AS export
COPY --from=builder /app/target/release/oxide-sloc /oxide-sloc
