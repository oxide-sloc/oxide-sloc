    given-names: Nima
    email: nimzshafie@gmail.com
repository-code: "https://github.com/oxide-sloc/oxide-sloc"
url: "https://github.com/oxide-sloc/oxide-sloc"
license: AGPL-3.0-or-later
version: 1.6.24
date-released: "2026-10-16"
keywords:
  - sloc
  - code-metrics
  - static-analysis
  - cyclomatic-complexity
  - cocomo
  - software-measurement
  - rust
